FluTabBarItem {
    background-color: transparent;
    border: none;
    font-size: 12px;
}

FluTabBarItem:hover {
    background-color: transparent;
}

FluTabBarItem:pressed {
    background-color: transparent;
}

FluTabBarItem:pressed #textBtn {
    color: rgba(0, 0, 0, 114);
}

FluTabBarItem[selected=true] {
    background-color: transparent;
}

FluTabBarItem[selected=true]:hover {
    background-color: transparent;
}

FluTabBarItem[selected=true] #textBtn {
    color: rgba(0, 0, 0, 228);
    font-weight: 600;
}

#iconBtn {
    background-color: transparent;
    border: none;
}

#textBtn {
    background-color: transparent;
    border: none;
    text-align: left;
    color: rgba(0, 0, 0, 158);
}

#closeBtn {
    background-color: transparent;
    border: none;
    border-radius: 4px;
}

#closeBtn:hover {
    background-color: rgba(0, 0, 0, 6);
}

#closeBtn:pressed {
    background-color: rgba(0, 0, 0, 9);
}

FluTabBarItem:disabled #textBtn {
    color: rgba(0, 0, 0, 92);
}

FluTabBarItem:disabled #iconBtn {
    color: rgba(0, 0, 0, 92);
}
