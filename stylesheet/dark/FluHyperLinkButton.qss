FluHyperLinkButton {
    border: none;
    border-radius: 4px;
    color: rgb(152, 197, 232);
    font-size: 12px;
    background-color: transparent;
    padding: 8px;
    cursor: pointinghand;
}

FluHyperLinkButton:hover {
    color: rgb(180, 214, 240);
    text-decoration: underline;
}

FluHyperLinkButton:pressed {
    color: rgb(120, 165, 205);
}

FluHyperLinkButton:focus {
    outline: 1px solid rgb(152, 197, 232);
    border-radius: 4px;
}

FluHyperLinkButton:disabled {
    color: rgba(152, 197, 232, 100);
}