/*FluSlider dark theme — handle is painted by FluSlider::paintEvent, not QSS*/

QSlider:horizontal {
    min-width: 150px;
    min-height: 20px;
}

QSlider::groove:horizontal {
    height: 3px;
    min-width: 150px;
    background-color: rgb(154, 154, 154);
    border-radius: 1.5px;
}

QSlider::sub-page:horizontal {
    background-color: rgb(118, 185, 237);
    border-radius: 1.5px;
}

QSlider::add-page:horizontal {
    background-color: rgb(154, 154, 154);
    border-radius: 1.5px;
}

/*FluSlider Vertical*/

QSlider:vertical {
    min-width: 20px;
    min-height: 150px;
}

QSlider::groove:vertical {
    width: 3px;
    min-height: 150px;
    background-color: rgb(154, 154, 154);
    border-radius: 1.5px;
}

QSlider::sub-page:vertical {
    background-color: rgb(154, 154, 154);
    border-radius: 1.5px;
}

QSlider::add-page:vertical {
    background-color: rgb(118, 185, 237);
    border-radius: 1.5px;
}

QSlider::groove:horizontal:disabled,
QSlider::groove:vertical:disabled {
    background-color: rgb(60, 60, 60);
}
