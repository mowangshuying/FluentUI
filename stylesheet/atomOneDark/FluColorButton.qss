FluColorButton {
    background-color: [[backgroundColor]];
    border: 1px solid rgb(71, 74, 79);
    border-radius: 4px;
    width: 30px;
    height: 30px;
}

FluColorButton:hover {
    border: 1px solid rgb(82, 139, 255);
}

FluColorButton:disabled {
    background-color: rgba(255, 255, 255, 25);
    border: 1px solid transparent;
    border-radius: 4px;
    width: 30px;
    height: 30px;
}