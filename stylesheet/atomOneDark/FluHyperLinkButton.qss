FluHyperLinkButton {
    border: none;
    border-radius: 4px;
    color: rgb(90, 116, 194);
    font-size: 12px;
    background-color: transparent;
    padding: 8px;
    cursor: pointinghand;
}

FluHyperLinkButton:hover {
    color: rgb(120, 145, 220);
    text-decoration: underline;
}

FluHyperLinkButton:pressed {
    color: rgb(70, 92, 160);
}

FluHyperLinkButton:focus {
    outline: 1px solid rgb(90, 116, 194);
    border-radius: 4px;
}

FluHyperLinkButton:disabled {
    color: rgba(90, 116, 194, 100);
}