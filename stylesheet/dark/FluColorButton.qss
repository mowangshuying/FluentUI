FluColorButton {
    background-color: [[backgroundColor]];
    border: 1px solid rgb(60, 60, 60);
    border-radius: 4px;
    width: 30px;
    height: 30px;
}

FluColorButton:hover {
    border: 1px solid rgb(118, 185, 237);
}

FluColorButton:disabled {
    background-color: rgba(255, 255, 255, 25);
    border: 1px solid transparent;
    border-radius: 4px;
    width: 30px;
    height: 30px;
}