FluCalendarMonthView {
    background-color: rgb(44, 48, 54);
}

#label {
    color: rgb(222, 222, 222);
    width: 40px;
    height: 40px;
    border: 1px solid transparent;
    border-radius: 20px;
}

#label[curMonth=false] {
    color: rgb(151, 151, 151);
}

#label[today=true] {
    color: rgb(0, 0, 0);
    background-color: rgb(82, 139, 255);
}

#label:hover {
    background-color: rgb(50, 54, 60);
}

#label:hover[today=true] {
    color: rgb(0, 0, 0);
    background-color: rgb(78, 106, 189);
}

#label[selected=false] {
    /* background-color: rgb(0, 90, 0); */
    border: 1px solid transparent;
}

#label[selected=true] {
    border: 1px solid rgb(78, 106, 189);
}