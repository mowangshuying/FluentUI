FluColorButton {
    background-color: [[backgroundColor]];
    border: 1px solid rgb(229, 229, 229);
    border-radius: 4px;
    width: 30px;
    height: 30px;
}

FluColorButton:hover {
    border: 1px solid rgb(0, 90, 158);
}

FluColorButton:disabled {
    background-color: rgba(0, 0, 0, 25);
    border: 1px solid transparent;
    border-radius: 4px;
    width: 30px;
    height: 30px;
}