FluTabView {
    border: 1px solid transparent;
    border-radius: 8px;
    background-color: rgb(33, 37, 43);
}

#sWidget {
    background-color: rgb(54, 58, 66);
    border-left: 1px solid rgb(53, 58, 65);
    border-right: 1px solid rgb(53, 58, 65);
    border-bottom: 1px solid rgb(53, 58, 65);
    border-top: none;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

#addTabBtn {
    background-color: rgb(82, 139, 255);
    border: 1px solid transparent;
    border-radius: 4px;
}

#addTabBtn:hover {
    background-color: rgb(114, 178, 229);
}
