FluPPushButton {
	qproperty-ppBackgroundColor: rgb(45, 45, 45);
	qproperty-ppBorderColor: rgb(55, 55, 55);
	qproperty-ppTextColor: rgb(255, 255, 255);
}

FluPPushButton[ppMouseState="Hover"] {
	qproperty-ppBackgroundColor: rgb(55, 55, 55);
	qproperty-ppBorderColor: rgb(65, 65, 65);
	qproperty-ppTextColor: rgb(255, 255, 255);
}

FluPPushButton[ppMouseState="Pressed"] {
	qproperty-ppBackgroundColor: rgb(40, 40, 40);
	qproperty-ppBorderColor: rgb(50, 50, 50);
	qproperty-ppTextColor: rgba(255, 255, 255, 180);
}

FluPPushButton:disabled {
	qproperty-ppBackgroundColor: rgb(40, 40, 40);
	qproperty-ppBorderColor: rgb(42, 42, 42);
	qproperty-ppTextColor: rgba(255, 255, 255, 70);
}
