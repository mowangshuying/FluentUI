FluHyperLinkButton {
    border: none;
    border-radius: 4px;
    color: rgb(0, 66, 117);
    font-size: 12px;
    background-color: transparent;
    padding: 8px;
    cursor: pointinghand;
}

FluHyperLinkButton:hover {
    color: rgb(29, 62, 87);
    text-decoration: underline;
}

FluHyperLinkButton:pressed {
    color: rgb(0, 40, 70);
}

FluHyperLinkButton:focus {
    outline: 1px solid rgb(0, 66, 117);
    border-radius: 4px;
}

FluHyperLinkButton:disabled {
    color: rgba(0, 66, 117, 100);
}